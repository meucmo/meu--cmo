# =============================================================================
# MEU CMO — Variáveis de ambiente (modelo)
# Copie para .env (local) ou configure em Railway → Variables.
# =============================================================================

# --- Aplicação / Gateway ---
# Porta pública que o Railway expõe (o Railway injeta automaticamente).
# Não precisa definir manualmente no Railway.
PORT=3001

# Liga o modo "gateway": o Express passa a servir o build do site (estático)
# e a fazer proxy do PocketBase em /hcgi/platform. DEVE ser true no Railway.
SERVE_WEB=true

# Ambiente Node.
NODE_ENV=production

# --- PocketBase ---
# URL interna do PocketBase (roda no mesmo container, porta 8090).
POCKETBASE_INTERNAL_URL=http://localhost:8090

# Chave de encriptação dos dados do PocketBase (OBRIGATÓRIA).
# Gere uma aleatória forte, ex: openssl rand -base64 32
# NUNCA altere depois de criar dados — os arquivos ficam ligados a essa chave.
PB_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-forte

# Superusuário do PocketBase (painel admin em /hcgi/platform/_/).
PB_SUPERUSER_EMAIL=admin@meucmo.com
PB_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# --- Domínio público (usado para montar URLs de imagens/webhooks) ---
# Defina com o domínio que o Railway gerar, ex: https://meu-cmo.up.railway.app
WEBSITE_DOMAIN=meu-cmo.up.railway.app
WEBSITE_ID=
PROXY_ENTRANCE_ID=

# =============================================================================
# SERVIÇOS DE PLATAFORMA (opcionais / avançado)
# =============================================================================
# Os recursos de IA e assinaturas usam APIs da plataforma Hostinger AI Builder.
# No Railway esses endpoints não estão disponíveis por padrão. Sem as chaves
# abaixo, o app funciona normalmente (auth, dashboard, planos salvos, banco de
# ideias, histórico, admin, PWA) MAS a GERAÇÃO DE PLANOS POR IA e o CHECKOUT
# de assinaturas ficarão indisponíveis.
#
# Para habilitá-los você precisará fornecer endpoints/chaves compatíveis.

# Endpoint + chave do serviço de IA (formato da plataforma).
INTEGRATED_AI_API_URL=
INTEGRATED_AI_API_KEY=

# Endpoint + credenciais do serviço de assinaturas/ecommerce (formato da plataforma).
ECOMMERCE_API_URL=
ECOMMERCE_API_KEY=
ECOMMERCE_STORE_ID=
